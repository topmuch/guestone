# ════════════════════════════════════════════════════════════════════
# Guest One — Variables d'environnement pour Coolify (Dockerfile)
# ════════════════════════════════════════════════════════════════════
# Copiez ces variables dans Coolify → Environment Variables.
# Les secrets marqués [OBLIGATOIRE] doivent être générés avec :
#   openssl rand -base64 32
# ════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=file:/app/data/qrtags.db

# ─── URLs publiques ─────────────────────────────────────────────────
# Remplacez par votre domaine Coolify réel
NEXT_PUBLIC_BASE_URL=https://guestone.votre-domaine.com
NEXT_PUBLIC_APP_URL=https://guestone.votre-domaine.com
NEXTAUTH_URL=https://guestone.votre-domaine.com

# ─── Secrets [OBLIGATOIRE] ──────────────────────────────────────────
# Générez avec : openssl rand -base64 32
NEXTAUTH_SECRET=REMPLACER_PAR_OPENSSL_RAND_BASE64_32
ENCRYPTION_KEY=REMPLACER_PAR_OPENSSL_RAND_BASE64_32
# Générez avec : openssl rand -base64 24
CRON_SECRET=REMPLACER_PAR_OPENSSL_RAND_BASE64_24

# ─── Superadmin par défaut ──────────────────────────────────────────
# Créé automatiquement au 1er démarrage.
# ⚠️ Changez le mot de passe après la 1ère connexion !
ADMIN_EMAIL=admin@qrtags.com
ADMIN_PASSWORD=admin123

# ─── Backup DB (optionnel) ──────────────────────────────────────────
CRON_BACKUP_ENABLED=false
CRON_BACKUP_SECRET=REMPLACER_PAR_OPENSSL_RAND_BASE64_24

# ─── Services externes (optionnels) ─────────────────────────────────
# Laissez vides en dev → l'app utilise des fallbacks automatiques.

# WhatsApp Business (Wakit) — notifications scan
WAKIT_API_KEY=
WAKIT_BASE_URL=https://api.wakit.ai/v1
WAKIT_PHONE_NUMBER_ID=
WAKIT_TEMPLATE_SCAN_ALERT=baggage_scan_alert

# IA (Groq) — chatbot trouveur, anti-doublon, traduction auto
GROQ_API_KEY=
GROQ_AI_ENABLED=true
GROQ_CHAT_ENABLED=true
GROQ_SCAN_GUARD_ENABLED=true
GROQ_AUTO_TRANSLATE_ENABLED=true

# ─── Stripe (paiements boutique bracelets) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Email (Nodemailer SMTP) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@votre-domaine.com

# ─── Web Push (notifications push PWA) ──────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@votre-domaine.com

# ─── Tâches de fond (instrumentation.ts) ────────────────────────────
# En production, les jobs tournent par défaut. Mettre '1' pour forcer en dev.
ENABLE_BACKGROUND_JOBS=1
