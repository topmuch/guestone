# ════════════════════════════════════════════════════════════════════
# QRTagsPro — Variables Coolify (PRODUCTION)
# ════════════════════════════════════════════════════════════════════
# Copiez ces variables dans Coolify → Environment Variables
# Les secrets doivent être générés avec: openssl rand -base64 32
# ════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Base de données SQLite (chemin dans le container Coolify)
# Le volume persistant doit être mappé sur /app/data
DATABASE_URL=file:/app/data/qrtags.db

# ─── URLs publiques (OBLIGATOIRE — votre domaine Coolify) ──────────
# ⚠️ Si non défini, les URLs générées (emails, QR codes, liens) seront cassées
NEXT_PUBLIC_BASE_URL=https://guestone.votre-domaine.com
NEXT_PUBLIC_APP_URL=https://guestone.votre-domaine.com
NEXTAUTH_URL=https://guestone.votre-domaine.com

# ─── Secrets (OBLIGATOIRE — openssl rand -base64 32) ───────────────
# ⚠️ NEXTAUTH_SECRET: signing key pour les JWT — JAMAIS la valeur par défaut
NEXTAUTH_SECRET=<générer avec: openssl rand -base64 32>
# ⚠️ ENCRYPTION_KEY: chiffrement de données sensibles
ENCRYPTION_KEY=<générer avec: openssl rand -base64 32>
# ⚠️ CRON_SECRET: authentification des endpoints cron internes
CRON_SECRET=<générer avec: openssl rand -base64 32>

# ─── Superadmin (créé au 1er démarrage) ────────────────────────────
ADMIN_EMAIL=admin@qrtags.com
ADMIN_PASSWORD=admin123
# ⚠️ Changez le mot de passe après la 1ère connexion !

# ─── Backup DB (optionnel) ─────────────────────────────────────────
CRON_BACKUP_ENABLED=true
CRON_BACKUP_SECRET=<générer avec: openssl rand -base64 32>

# ─── Background Jobs ───────────────────────────────────────────────
# Les jobs tournent en in-process (instrumentation.ts).
# ENABLE_DEMO_RESET=1 pour activer le reset démo auto (désactivé par défaut en prod)
ENABLE_DEMO_RESET=

# ─── Services externes (optionnels) ────────────────────────────────
WAKIT_API_KEY=
GROQ_API_KEY=
GROQ_AI_ENABLED=true
