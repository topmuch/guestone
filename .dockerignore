# ════════════════════════════════════════════════════════════════════
# Guest One — .dockerignore
# Ce qui est EXCLU du contexte de build Docker (envoyé au daemon).
# Réduit la taille du contexte → build plus rapide + cache optimal.
# ════════════════════════════════════════════════════════════════════

# ─── Dépendances installées (recréées dans le stage deps) ───────────
node_modules
**/node_modules

# ─── Build artifacts (recréés dans le stage builder) ────────────────
.next
out
dist
build
*.tsbuildinfo

# ─── Fichiers de log et runtime ─────────────────────────────────────
dev.log
server.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environnement (jamais dans l'image !) ──────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
# On GARDE .env.example et .env.local.example (utiles comme documentation)
!.env.example
!.env.local.example

# ─── Base de données locale et uploads ──────────────────────────────
db/
*.db
*.db-journal
*.sqlite
*.sqlite3
public/uploads
data/

# ─── Git et CI ──────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github
.gitlab-ci.yml

# ─── Docker ( évite récursion ) ─────────────────────────────────────
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# ─── IDE / OS ───────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Tests et caches ────────────────────────────────────────────────
coverage
.nyc_output
.cache
.eslintcache
.turbo

# ─── Documentation (pas utile dans l'image runtime) ─────────────────
README.md
DEPLOYMENT.md
*.md
!prisma/*.md

# ─── Scripts de build Coolify (sandbox locale) ─────────────────────
.zscripts
tests
examples
download

# ─── nixpacks (désactivé en faveur du Dockerfile) ───────────────────
nixpacks.toml
nixpacks.toml.disabled
