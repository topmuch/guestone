# ════════════════════════════════════════════════════════════════════
# Guest One — nixpacks.toml pour Coolify
# Coolify utilise nixpacks par défaut (pas de Dockerfile)
# ════════════════════════════════════════════════════════════════════

[phases.setup]
nixPkgs = ['nodejs_20', 'openssl']
aptPkgs = ['sqlite3', 'ca-certificates']

[phases.install]
cmds = [
  'npm install --legacy-peer-deps --no-audit --no-fund'
]

[phases.build]
cmds = [
  'npx prisma generate',
  'npm run build',
  'cp -r .next/static .next/standalone/.next/ || true',
  'cp -r public .next/standalone/public || true',
  'cp -r prisma .next/standalone/prisma || true',
  'cp -r scripts .next/standalone/scripts || true',
  'cp -r node_modules .next/standalone/node_modules || true',
  'cp package.json .next/standalone/package.json || true'
]
dependsOn = ['install']

[start]
# 1. Seeds depuis /app (node_modules complet)
# 2. cd standalone + start server (trouve public/ et .next/static/)
cmd = 'mkdir -p /app/data && npx prisma db push --schema=./prisma/schema.prisma --skip-generate --accept-data-loss 2>&1; node scripts/seed-services.cjs 2>&1 || true; node scripts/seed-airbnb-services.cjs 2>&1 || true; node scripts/seed-modeles-appareils.cjs 2>&1 || true; node scripts/seed-modules.cjs 2>&1 || true; node scripts/seed-plans.cjs 2>&1 || true; node scripts/create-admin.cjs 2>&1 || true; node scripts/seed-demo.cjs 2>&1 || true; cd /app/.next/standalone && exec node server.js'

[variables]
NODE_ENV = 'production'
NEXT_TELEMETRY_DISABLED = '1'
PORT = '3000'
HOSTNAME = '0.0.0.0'
DATABASE_URL = 'file:/app/data/qrtags.db'
